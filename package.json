{
  "name": "gold-loan-portal",
  "version": "1.0.0",
  "description": "Production-minded gold loan intake portal with an AI agent and exact financial maths",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch backend/src/server.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm run build:backend && npm --prefix frontend run build",
    "build:backend": "tsc -p backend/tsconfig.json",
    "seed": "tsx backend/src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx backend/eval/agentConversations.eval.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
